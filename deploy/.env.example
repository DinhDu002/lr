# LR's company services (deploy/compose.chain.yaml, deploy/compose.signer.yaml). Copy to deploy/.env;
# docs/runbooks/lr-services.md explains each one. deploy/.env may hold secrets: never commit it.

# The seed's P2P port, published on the server.
# LR_P2P_PORT=9444
# The network: test unless a local check runs dev.
# LR_NETWORK=test

# deploy/compose.signer.yaml, on the project owner's machine: the company's seed, and the file of
# the Checkpoint signer's 24 words (a path, never the words themselves).
# LR_SEED=seed.example.org:9444
# CHECKPOINT_WORDS=/path/to/words
